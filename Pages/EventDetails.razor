@page "/Events/EventDetails/{eventID:int}"
@inject EventManager eventManager;
@inject NavigationManager navManager;
@using EventEase_App.Services;

@code
{

    [Parameter]
    public int eventID {get; set;}

    [Parameter]
    public Event? currentEvent {get; set;}

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        currentEvent = eventManager.ListEvents().FirstOrDefault<Event>(e => e.ID == eventID);
        if(currentEvent == null)
        {
            navManager.NotFound();
        }
    }
}

@if (currentEvent is not null)
{
    <section class="event-details" aria-labelledby="event-name">
        <header class="detail-panel">
            <p class="detail-label">Event name</p>
            <h1 id="event-name">@currentEvent.Name</h1>
        </header>

        <dl class="detail-grid">
            <div class="detail-panel">
                <dt>Date</dt>
                <dd>@currentEvent.Date</dd>
            </div>
            <div class="detail-panel">
                <dt>Location</dt>
                <dd>@currentEvent.Location</dd>
            </div>
            <div class="detail-panel description">
                <dt>Description</dt>
                <dd>@currentEvent.Description</dd>
            </div>
        </dl>
    </section>
}
